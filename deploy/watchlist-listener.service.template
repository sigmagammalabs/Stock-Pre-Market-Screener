[Unit]
Description=Pre-Market Screener Telegram Listener
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__VPS_USER__
WorkingDirectory=__PROJECT_DIR__
ExecStart=__PROJECT_DIR__/.venv/bin/python main.py listen --universe custom --tickers AAPL,NVDA,TSLA,AMD,MSFT
Restart=on-failure
RestartSec=10
EnvironmentFile=__PROJECT_DIR__/.env

# Härtung
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
